{
  "name": "plazo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "arc:verify": "pnpm --filter @plazo/arc-verify verify",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "parity": "pnpm --filter @plazo/plan-core parity",
    "boundary": "node tools/check-boundaries.mjs",
    "ci": "pnpm boundary && pnpm build && pnpm test"
  },
  "devDependencies": {
    "turbo": "2.10.7",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.45.2"
    }
  }
}
