{
  "name": "@plazo/arc-verify",
  "version": "0.1.0",
  "description": "Asserts every Arc primitive the protocol depends on, and runs the vertical slice against the live token. A CI gate, not a report.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "arc-verify": "./dist/cli.js",
    "arc-slice": "./dist/slice-cli.js",
    "arc-faucet": "./dist/faucet-cli.js",
    "arc-fx-spike": "./dist/fx-spike-cli.js",
    "arc-inflow": "./dist/inflow-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "tsx src/cli.ts",
    "verify:mainnet": "tsx src/cli.ts --network mainnet",
    "slice": "tsx src/slice-cli.ts",
    "faucet": "tsx src/faucet-cli.ts",
    "spike:cctp": "tsx src/spike-cli.ts",
    "spike:fx": "tsx src/fx-spike-cli.ts",
    "inflow": "tsx src/inflow-cli.ts",
    "gov08": "tsx src/gov08-cli.ts"
  },
  "dependencies": {
    "@plazo/plan-core": "workspace:*",
    "viem": "2.55.10"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
