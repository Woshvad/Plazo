{
  "name": "@plazo/plan-core",
  "version": "0.1.0",
  "description": "Canonical plan identity, authorization-nonce and clone-address derivation. Reproducible without Plazo.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "parity": "vitest run test/parity.test.ts"
  },
  "dependencies": {
    "viem": "2.55.10"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
