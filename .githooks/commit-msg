#!/bin/sh
# Strip AI attribution trailers from commit messages.
# Backstop for the project rule: no Claude/AI attribution on any Plazo commit.
MSG_FILE="$1"
grep -v -i -E '^(Co-Authored-By:.*(Claude|Anthropic|noreply@anthropic)|🤖 Generated with|Generated with \[Claude Code\])' "$MSG_FILE" > "$MSG_FILE.tmp"
mv "$MSG_FILE.tmp" "$MSG_FILE"
exit 0
