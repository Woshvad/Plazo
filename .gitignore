# Planning docs stay local (config.json: commit_docs = false)
.planning/

# Dependencies
node_modules/
contracts/lib/

# Secrets
.env
.env.*
!.env.example

# Build output
out/
cache/
broadcast/
.next/
dist/
.turbo/
*.tsbuildinfo

# Generated
contracts/corpus/
packages/abi/generated/

# Live-spike artefacts. Message bytes, attestations and tx hashes from a run
# against real testnet money — evidence for a finding, not repo content.
packages/arc-verify/.spike/

# drizzle-kit's machine-local scratch only.
#
# The generated SQL under `services/*/drizzle/*.sql` and the snapshots under
# `services/*/drizzle/meta/` are committed and stay committed: the DDL is the
# artefact a reviewer reads instead of running a database, and the snapshots are
# what the next `generate` diffs against. Ignoring them would make every schema
# change unreviewable and every migration a fresh baseline.
services/*/.drizzle/

# Local
*.log
.DS_Store

# Next regenerates this, and it flips between the dev and build route-type
# paths depending on which command ran last. Pure churn in diffs.
apps/*/next-env.d.ts
